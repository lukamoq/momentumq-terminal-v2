# Copy to .env. Do not commit .env.

# Tavily — published-call discovery (news/search). https://app.tavily.com/home
TAVILY_API_KEY=

# Massive — market data (stocks aggregates). https://massive.com
# I:SPX is an indices product and 403s on a stocks-only plan; this
# project uses SPY × 10 as the S&P 500 level series (see README).
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
